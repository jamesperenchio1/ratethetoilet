VITE_SUPABASE_URL=https://ratethetoilet-api.gingerbrosshop.com
VITE_SUPABASE_ANON_KEY=
# Optional — error monitoring. Leave blank to disable (local dev, PR previews).
VITE_SENTRY_DSN=
# Optional — Cloudflare Turnstile site key. Leave blank to disable the widget.
VITE_TURNSTILE_SITE_KEY=

# Optional — Google Places API (New) key. When set, place search uses Google instead of Photon.
VITE_GOOGLE_PLACES_API_KEY=
